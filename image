+=2;reasons.push("Contains @ symbol");}
  if(/^\d{1,3}(\.\d{1,3}){3}$/.test(host)){score+=3;reasons.push("Uses IP address instead of domain");}
  if((host.match(/-/g)||[]).length>=2){score+=1;reasons.push("Many hyphens in domain");}
  if((host.match(/\./g)||[]).length>=4){score+=2;reasons.push("Too many subdomains");}
  if(!/^https:/i.test(url)){score+=1;reasons.push("No HTTPS");}
  var found=KEYWORDS.filter(function(k){return low.indexOf(k)>-1;});
  if(found.length){score+=2;reasons.push("Suspicious keywords: "+found.join(", "));}
  if(SHORTENERS.some(function(s){return host.indexOf(s)>-1;})){score+=2;reasons.push("Shortened link");}
  if(BADTLD.some(function(t){return host.endsWith(t);})){score+=1;reasons.push("Risky domain ending");}

  var verdict = score>=5 ? "PHISHING" : score>=3 ? "SUSPICIOUS" : "SAFE";
  return {verdict:verdict, score:score, reasons:reasons};
}

function run(){
  var v=document.getElementById("url").value;
  if(!v.trim()) return;
  var r=check(v);
  document.getElementById("out").classList.remove("hidden");
  var vEl=document.getElementById("verdict");
  var list=document.getElementById("reasons");
  var fill=document.getElementById("fill");
  list.innerHTML="";
  if(!r){ vEl.textContent="Invalid URL"; return; }
  var color = r.verdict=="PHISHING" ? "#d93636" : r.verdict=="SUSPICIOUS" ? "#d98a00" : "#1f9d55";
  vEl.textContent = r.verdict;
  vEl.style.color = color;
  document.getElementById("score").textContent = "Risk score: "+r.score+" / 12";
  fill.style.background = color;
  fill.style.width = Math.min(100, r.score/12*100)+"%";
  var items = r.reasons.length ? r.reasons : ["No risky patterns found"];
  items.forEach(function(t){
    var li=document.createElement("li");
    li.textContent=t;
    list.appendChild(li);
  });
}
</script>
